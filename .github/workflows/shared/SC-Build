name: SC-Build

on:
  workflow_call:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 8.0.x

      - name: Restore
        run: dotnet restore

      - name: Build
        run: dotnet build --configuration Release --no-restore

      - name: Test
        run: dotnet test --configuration Release --no-build

      - name: Pack (if applicable)
        run: |
          echo "Packing modules if repo contains packable projects..."
          dotnet pack --configuration Release --no-build --output ./artifacts || true

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: sc-build
          path: artifacts
